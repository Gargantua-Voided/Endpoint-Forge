{
  "name": "endpoint-forge",
  "productName": "Endpoint Forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "package-app": "npm run build && electron-builder --win -p never",
    "electron:start": "npm run build && electron .",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/download-intune-util.js"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Gargantua-Voided",
        "repo": "Endpoint-Forge"
      }
    ],
    "appId": "com.endpointforge.app",
    "productName": "Endpoint Forge",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "bin/IntuneWinAppUtil.exe",
        "to": "IntuneWinAppUtil.exe"
      },
      {
        "from": "bin/nsis",
        "to": "nsis"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "logo.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.png"
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Endpoint Forge"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
